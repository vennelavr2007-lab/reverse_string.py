def reverse_string(text):
    stack = []
    for char in text:
        stack.append(char)
    reversed_text = ""
    while stack:
        reversed_text += stack.pop()
    return reversed_text
text = input("Enter a string: ")
print("Reversed string:", reverse_string(text))

